usethis::use_package("GGally", type = "Imports")
devtools::document()
devtools::load_all()
panels_partisan()
panels_rep_decompose()
panels_dem_decompose()
panels_ind_decompose()
p <- plot_policy_heatgrid(
years = 2019:2021,
policy_x = "abortion",
policy_y = "healthcare",
type = "rf",
panels = panels_partisan()
)
p
raw_2016 <- get_policy_raw(year = 2016, cols = c("immig", "guns"))
raw_2016 <- get_policy_raw(year = 2016, cols = c("immig", "guns", "healthcare"))
devtools::document()
devtools::load_all()
p <- plot_policy_heatgrid(
years = 2014:2021,
policy_x = "guns",
policy_y = "immig",
type = "rf",
panels = panels_partisan()
)
p
devtools::document()
devtools::load_all()
# Full range of years covered by packaged data
years <- 2014:2021
# 1) Basic partisan panels (Population/Rep/Ind/Dem), RF type
p1 <- plot_policy_heatgrid(
years    = years,
policy_x = "guns",     # will be resolved to "guns_rf" for type = "rf"
policy_y = "immig",    # will be resolved to "immig_rf"
type     = "rf",
panels   = panels_partisan(),
scale    = "across_years",
scale_ref = "population"
)
print(p1)
devtools::document()
