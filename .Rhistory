devtools::document()
devtools::load_all()
# Create a folder for local test output.
dir.create("test_figures", showWarnings = FALSE)
# 1. Single heatmap with marginal distributions.
p1 <- plot_policy_heat_single(
year = 2019,
policy_x = "immig",
policy_y = "trade",
model = "rf",
group = "population"
)
pdf("test_figures/01_single_heatmap.pdf", width = 8, height = 8)
grid::grid.draw(p1)
dev.off()
setwd("C:/Users/TimYu/Downloads/examples")
# Create a folder for local test output.
dir.create("test_figures", showWarnings = FALSE)
# 1. Single heatmap with marginal distributions.
p1 <- plot_policy_heat_single(
year = 2019,
policy_x = "immig",
policy_y = "trade",
model = "rf",
group = "population"
)
pdf("test_figures/01_single_heatmap.pdf", width = 8, height = 8)
grid::grid.draw(p1)
dev.off()
# Optional examples for subgroups in the single heatmap style.
p1_rep_college <- plot_policy_heat_single(
year = 2019,
policy_x = "immig",
policy_y = "trade",
model = "rf",
group = "republican",
subgroup = "college"
)
pdf("test_figures/01b_single_heatmap_rep_college.pdf", width = 8, height = 8)
grid::grid.draw(p1_rep_college)
dev.off()
# 2. One-row heatmap: Population | Republican | Independent | Democrat.
p2 <- plot_policy_heatrow_year(
year = 2021,
policy_x = "healthcare",
policy_y = "abortion",
model = "rf"
)
save_policy_heatgrid(
filename = "test_figures/02_heatmap_row.pdf",
plot = p2
)
# 3. Partisan decomposition grid over multiple years.
p3 <- plot_policy_partisan_grid(
years = 2019:2021,
policy_x = "immig",
policy_y = "trade",
model = "rf"
)
save_policy_heatgrid(
filename = "test_figures/03_partisan_grid.pdf",
plot = p3
)
# 4. Subgroup analysis grid for a partisan group.
p4 <- plot_policy_subgroup_grid(
years = 2014:2021,
policy_x = "enviro",
policy_y = "guns",
model = "rf",
group = "republican"
)
save_policy_heatgrid(
filename = "test_figures/04_subgroup_grid_republican.pdf",
plot = p4
)
# 4b. Subgroup analysis grid for the full population.
p4_pop <- plot_policy_subgroup_grid(
years = 2014:2021,
policy_x = "enviro",
policy_y = "guns",
model = "rf",
group = "population"
)
save_policy_heatgrid(
filename = "test_figures/04b_subgroup_grid_population.pdf",
plot = p4_pop
)
